# Copy to .env (for vite dev) or .dev.vars (for wrangler dev) and fill in real values.
# Only VITE_* variables are exposed to the browser. Keep secrets server-side.

# Public API base URL consumed by the client.
VITE_API_BASE_URL=

# Anthropic API key used by the server-side narrative generator
# (src/server/narrate.ts). If unset, the report falls back to the
# deterministic Hebrew narrative from the evaluation engine.
ANTHROPIC_API_KEY=
